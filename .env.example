# Optional. Without these, flaky-finder runs in rules-only mode and reports
# UNVERIFIED for anything the deterministic rules don't recognize — it never
# guesses. Any OpenAI-chat-compatible endpoint serving an open-weight model works.

# Groq (free tier, serves Llama/Gemma/Qwen):
FLAKY_FINDER_API_KEY=
FLAKY_FINDER_BASE_URL=https://api.groq.com/openai/v1
FLAKY_FINDER_MODEL=llama-3.1-8b-instant
