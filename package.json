{
  "name": "flaky-finder",
  "version": "0.1.0",
  "description": "Classifies CI test failures as ENVIRONMENT_SIGNAL_DETECTED, SUSPECTED_REGRESSION, or UNVERIFIED using an auditable rule engine first, with an optional open-weight-model fallback for the residual \u2014 never claiming more than a single log can establish.",
  "type": "module",
  "bin": {
    "flaky-finder": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "tsx src/cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "coverage": "c8 npm test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.check.json --noEmit"
  },
  "dependencies": {
    "undici": "^6.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.14.0",
    "c8": "^10.1.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT"
}
